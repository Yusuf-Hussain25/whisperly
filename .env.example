# Firebase web app config: Firebase Console -> Project settings -> Your apps -> </> (web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Image uploads (profile pictures + image messages)
# Provider: cloudinary (free, default) | firebase (needs Blaze plan) | inline (small images stored in Firestore)
VITE_UPLOAD_PROVIDER=cloudinary

# Cloudinary: Console -> Dashboard (cloud name); Settings -> Upload -> Upload presets -> add an "Unsigned" preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Demo data (npm run seed). The demo account powers "Explore with a demo account" on the login page.
VITE_DEMO_EMAIL=demo@whisperly-demo.dev
VITE_DEMO_PASSWORD=
# Password for the seeded contact accounts (only used by scripts/seed.mjs, never shipped to the browser)
SEED_PASSWORD=
